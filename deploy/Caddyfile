# Serves the built app (dist/ copied to /srv/vvz). Replace the site address with the Pi's domain
# for automatic HTTPS, or use :80 behind `tailscale serve` (see README, "Host it on a Raspberry Pi").
vvz.example.ch {
	root * /srv/vvz
	encode zstd gzip

	# Content-hashed assets and versioned course indexes (?v=<dump>) never change under the same URL.
	@immutable {
		path /assets/* /data/*
		not path /data/semesters.json
	}
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	header /data/semesters.json Cache-Control "no-cache"
	header /sw.js Cache-Control "no-cache"
	header /manifest.webmanifest Content-Type "application/manifest+json"

	# Client-side routes like /courses/204399 get the app shell.
	try_files {path} /index.html
	file_server
}
